   # ============================================
   # SmallSzyszka157 - .gitignore
   # ============================================

   # ---- Gradle build output ----
   .gradle/
   build/
   out/

   # ---- Machine-specific Gradle config ----
   # Contains an absolute path to your local JDK.
   # Every developer must create their own copy locally.
   gradle.properties

   # ---- IDE ----
   .idea/
   *.iml
   *.ipr
   *.iws
   .vscode/
   .settings/
   .project
   .classpath

   # ---- Compiled output ----
   *.class
   *.jar
   !gradle/wrapper/gradle-wrapper.jar

   # ---- Logs ----
   *.log
   logs/

   # ---- OS junk ----
   .DS_Store
   Thumbs.db
   desktop.ini

   # ---- Local run/test data ----
   run/
   server/
   plugins/
   worlds/
   world/
   world_nether/
   world_the_end/
